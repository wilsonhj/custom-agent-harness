{
  "permissions": {
    "deny": ["Edit(//var/lib/<harness-name>/ledger/**)"]
  },
  "allowManagedHooksOnly": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Library/Application Support/ClaudeCode/hooks/ledger-guard.mjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
